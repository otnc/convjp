{
  "name": "convjp",
  "version": "2.0.1",
  "description": "日本語用の文字化けエンコード・デコードライブラリ",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node build.mjs && cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/convjp.git"
  },
  "keywords": [
    "mojibake",
    "encode",
    "decode",
    "joke",
    "jp",
    "japan",
    "japanese",
    "shift_jis",
    "utf-8"
  ],
  "author": "otoneko.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/otnc/convjp/issues"
  },
  "homepage": "https://github.com/otnc/convjp#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
